{
  "name": "kong-api-client",
  "version": "3.0.0-rc.1",
  "description": "TypeScript client for the Kong Gateway Admin API",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "NOTICE",
    "LICENSES"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:unit": "vitest run --project unit",
    "test:contract": "vitest run --project contract",
    "test": "vitest run --project unit --project contract --coverage",
    "test:live": "scripts/test-live.sh",
    "generate": "node scripts/generate.mjs",
    "generate:check": "node scripts/generate.mjs --check",
    "record": "node scripts/record-schemas.mjs",
    "docs": "typedoc",
    "docs:check": "node scripts/check-docs-site.mjs",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run generate:check && npm test"
  },
  "author": {
    "name": "Vitor Vieira",
    "email": "vitor.ecomp@gmail.com",
    "url": "http://nobuffer.dev"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vitorecomp/kong-api-client.git"
  },
  "bugs": {
    "url": "https://github.com/vitorecomp/kong-api-client/issues"
  },
  "homepage": "https://github.com/vitorecomp/kong-api-client#readme",
  "keywords": [
    "Kong",
    "Api",
    "Admin",
    "Interface",
    "Gateway"
  ],
  "dependencies": {},
  "devDependencies": {
    "@eslint/js": "9.29.0",
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "3.2.4",
    "eslint": "9.29.0",
    "prettier": "3.6.2",
    "typedoc": "0.28.7",
    "typescript": "5.8.3",
    "typescript-eslint": "8.35.0",
    "vitest": "3.2.4"
  }
}
