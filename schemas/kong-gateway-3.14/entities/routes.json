{
  "fields": [
    {
      "id": {
        "auto": true,
        "type": "string"
      }
    },
    {
      "created_at": {
        "auto": true,
        "type": "integer"
      }
    },
    {
      "updated_at": {
        "auto": true,
        "type": "integer"
      }
    },
    {
      "name": {
        "type": "string"
      }
    },
    {
      "protocols": {
        "default": [
          "https"
        ],
        "elements": {
          "one_of": [
            "grpc",
            "grpcs",
            "http",
            "https",
            "tcp",
            "tls",
            "tls_passthrough",
            "udp",
            "ws",
            "wss"
          ],
          "type": "string"
        },
        "required": true,
        "type": "set"
      }
    },
    {
      "https_redirect_status_code": {
        "default": 426,
        "one_of": [
          301,
          302,
          307,
          308,
          426
        ],
        "required": true,
        "type": "integer"
      }
    },
    {
      "strip_path": {
        "default": true,
        "required": true,
        "type": "boolean"
      }
    },
    {
      "preserve_host": {
        "default": false,
        "required": true,
        "type": "boolean"
      }
    },
    {
      "request_buffering": {
        "default": true,
        "required": true,
        "type": "boolean"
      }
    },
    {
      "response_buffering": {
        "default": true,
        "required": true,
        "type": "boolean"
      }
    },
    {
      "tags": {
        "elements": {
          "required": true,
          "type": "string"
        },
        "type": "set"
      }
    },
    {
      "service": {
        "reference": "services",
        "type": "foreign"
      }
    },
    {
      "snis": {
        "elements": {
          "type": "string"
        },
        "type": "set"
      }
    },
    {
      "sources": {
        "elements": {
          "fields": [
            {
              "ip": {
                "type": "string"
              }
            },
            {
              "port": {
                "type": "integer"
              }
            }
          ],
          "type": "record"
        },
        "type": "set"
      }
    },
    {
      "destinations": {
        "elements": {
          "fields": [
            {
              "ip": {
                "type": "string"
              }
            },
            {
              "port": {
                "type": "integer"
              }
            }
          ],
          "type": "record"
        },
        "type": "set"
      }
    },
    {
      "methods": {
        "elements": {
          "type": "string"
        },
        "type": "set"
      }
    },
    {
      "hosts": {
        "elements": {
          "type": "string"
        },
        "type": "array"
      }
    },
    {
      "paths": {
        "elements": {
          "type": "string"
        },
        "type": "array"
      }
    },
    {
      "headers": {
        "keys": {
          "type": "string"
        },
        "type": "map",
        "values": {
          "elements": {
            "type": "string"
          },
          "type": "array"
        }
      }
    },
    {
      "regex_priority": {
        "default": 0,
        "type": "integer"
      }
    },
    {
      "path_handling": {
        "default": "v0",
        "one_of": [
          "v0",
          "v1"
        ],
        "type": "string"
      }
    }
  ]
}
