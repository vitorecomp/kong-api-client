{
  "fields": [
    {
      "id": {
        "auto": true,
        "type": "string"
      }
    },
    {
      "created_at": {
        "auto": true,
        "type": "integer"
      }
    },
    {
      "consumer": {
        "reference": "consumers",
        "required": true,
        "type": "foreign"
      }
    },
    {
      "name": {
        "required": true,
        "type": "string"
      }
    },
    {
      "client_id": {
        "auto": true,
        "required": false,
        "type": "string"
      }
    },
    {
      "client_secret": {
        "auto": true,
        "required": false,
        "type": "string"
      }
    },
    {
      "hash_secret": {
        "default": false,
        "required": true,
        "type": "boolean"
      }
    },
    {
      "redirect_uris": {
        "elements": {
          "type": "string"
        },
        "required": false,
        "type": "array"
      }
    },
    {
      "tags": {
        "elements": {
          "required": true,
          "type": "string"
        },
        "type": "set"
      }
    },
    {
      "client_type": {
        "default": "confidential",
        "one_of": [
          "confidential",
          "public"
        ],
        "required": true,
        "type": "string"
      }
    }
  ]
}
