{
  "fields": [
    {
      "protocols": {
        "default": [
          "grpc",
          "grpcs",
          "http",
          "https"
        ],
        "elements": {
          "one_of": [
            "grpc",
            "grpcs",
            "http",
            "https",
            "tcp",
            "tls",
            "tls_passthrough",
            "udp",
            "ws",
            "wss"
          ],
          "type": "string"
        },
        "required": true,
        "type": "set"
      }
    },
    {
      "consumer_group": {
        "eq": null,
        "reference": "consumer_groups",
        "type": "foreign"
      }
    },
    {
      "config": {
        "fields": [
          {
            "consumer_tag": {
              "default": "consumer",
              "type": "string"
            }
          },
          {
            "flush_timeout": {
              "type": "number"
            }
          },
          {
            "host": {
              "default": "localhost",
              "type": "string"
            }
          },
          {
            "metrics": {
              "default": [
                {
                  "consumer_identifier": "custom_id",
                  "name": "request_count",
                  "sample_rate": 1,
                  "stat_type": "counter",
                  "tags": [
                    "app:kong"
                  ]
                },
                {
                  "consumer_identifier": "custom_id",
                  "name": "latency",
                  "stat_type": "timer",
                  "tags": [
                    "app:kong"
                  ]
                },
                {
                  "consumer_identifier": "custom_id",
                  "name": "request_size",
                  "stat_type": "timer",
                  "tags": [
                    "app:kong"
                  ]
                },
                {
                  "consumer_identifier": "custom_id",
                  "name": "response_size",
                  "stat_type": "timer",
                  "tags": [
                    "app:kong"
                  ]
                },
                {
                  "consumer_identifier": "custom_id",
                  "name": "upstream_latency",
                  "stat_type": "timer",
                  "tags": [
                    "app:kong"
                  ]
                },
                {
                  "consumer_identifier": "custom_id",
                  "name": "kong_latency",
                  "stat_type": "timer",
                  "tags": [
                    "app:kong"
                  ]
                }
              ],
              "elements": {
                "fields": [
                  {
                    "consumer_identifier": {
                      "one_of": [
                        "consumer_id",
                        "custom_id",
                        "username"
                      ],
                      "type": "string"
                    }
                  },
                  {
                    "name": {
                      "one_of": [
                        "kong_latency",
                        "latency",
                        "request_count",
                        "request_size",
                        "response_size",
                        "upstream_latency"
                      ],
                      "required": true,
                      "type": "string"
                    }
                  },
                  {
                    "sample_rate": {
                      "type": "number"
                    }
                  },
                  {
                    "stat_type": {
                      "one_of": [
                        "counter",
                        "distribution",
                        "gauge",
                        "histogram",
                        "meter",
                        "set",
                        "timer"
                      ],
                      "required": true,
                      "type": "string"
                    }
                  },
                  {
                    "tags": {
                      "elements": {
                        "type": "string"
                      },
                      "type": "array"
                    }
                  }
                ],
                "type": "record"
              },
              "required": true,
              "type": "array"
            }
          },
          {
            "port": {
              "default": 8125,
              "type": "integer"
            }
          },
          {
            "prefix": {
              "default": "kong",
              "type": "string"
            }
          },
          {
            "queue": {
              "fields": [
                {
                  "concurrency_limit": {
                    "default": 1,
                    "one_of": [
                      -1,
                      1
                    ],
                    "type": "integer"
                  }
                },
                {
                  "initial_retry_delay": {
                    "default": 0.01,
                    "type": "number"
                  }
                },
                {
                  "max_batch_size": {
                    "default": 1,
                    "type": "integer"
                  }
                },
                {
                  "max_bytes": {
                    "type": "integer"
                  }
                },
                {
                  "max_coalescing_delay": {
                    "default": 1,
                    "type": "number"
                  }
                },
                {
                  "max_entries": {
                    "default": 10000,
                    "type": "integer"
                  }
                },
                {
                  "max_retry_delay": {
                    "default": 60,
                    "type": "number"
                  }
                },
                {
                  "max_retry_time": {
                    "default": 60,
                    "type": "number"
                  }
                }
              ],
              "required": true,
              "type": "record"
            }
          },
          {
            "queue_size": {
              "type": "integer"
            }
          },
          {
            "retry_count": {
              "type": "integer"
            }
          },
          {
            "route_name_tag": {
              "required": false,
              "type": "string"
            }
          },
          {
            "service_name_tag": {
              "default": "name",
              "type": "string"
            }
          },
          {
            "status_tag": {
              "default": "status",
              "type": "string"
            }
          }
        ],
        "required": true,
        "type": "record"
      }
    }
  ]
}
