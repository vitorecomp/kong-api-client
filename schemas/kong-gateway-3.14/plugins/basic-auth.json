{
  "fields": [
    {
      "consumer": {
        "eq": null,
        "reference": "consumers",
        "type": "foreign"
      }
    },
    {
      "protocols": {
        "default": [
          "grpc",
          "grpcs",
          "http",
          "https",
          "ws",
          "wss"
        ],
        "elements": {
          "one_of": [
            "grpc",
            "grpcs",
            "http",
            "https",
            "ws",
            "wss"
          ],
          "type": "string"
        },
        "required": true,
        "type": "set"
      }
    },
    {
      "consumer_group": {
        "eq": null,
        "reference": "consumer_groups",
        "type": "foreign"
      }
    },
    {
      "config": {
        "fields": [
          {
            "anonymous": {
              "type": "string"
            }
          },
          {
            "brute_force_protection": {
              "fields": [
                {
                  "redis": {
                    "fields": [
                      {
                        "cloud_authentication": {
                          "fields": [
                            {
                              "auth_provider": {
                                "one_of": [
                                  "aws",
                                  "azure",
                                  "gcp"
                                ],
                                "type": "string"
                              }
                            },
                            {
                              "aws_access_key_id": {
                                "type": "string"
                              }
                            },
                            {
                              "aws_assume_role_arn": {
                                "type": "string"
                              }
                            },
                            {
                              "aws_cache_name": {
                                "type": "string"
                              }
                            },
                            {
                              "aws_is_serverless": {
                                "default": true,
                                "required": false,
                                "type": "boolean"
                              }
                            },
                            {
                              "aws_region": {
                                "type": "string"
                              }
                            },
                            {
                              "aws_role_session_name": {
                                "type": "string"
                              }
                            },
                            {
                              "aws_secret_access_key": {
                                "type": "string"
                              }
                            },
                            {
                              "azure_client_id": {
                                "type": "string"
                              }
                            },
                            {
                              "azure_client_secret": {
                                "type": "string"
                              }
                            },
                            {
                              "azure_tenant_id": {
                                "type": "string"
                              }
                            },
                            {
                              "gcp_service_account_json": {
                                "type": "string"
                              }
                            }
                          ],
                          "required": false,
                          "type": "record"
                        }
                      },
                      {
                        "database": {
                          "default": 0,
                          "type": "integer"
                        }
                      },
                      {
                        "host": {
                          "type": "string"
                        }
                      },
                      {
                        "password": {
                          "type": "string"
                        }
                      },
                      {
                        "port": {
                          "default": 6379,
                          "type": "integer"
                        }
                      },
                      {
                        "server_name": {
                          "required": false,
                          "type": "string"
                        }
                      },
                      {
                        "ssl": {
                          "default": false,
                          "required": false,
                          "type": "boolean"
                        }
                      },
                      {
                        "ssl_verify": {
                          "default": true,
                          "required": false,
                          "type": "boolean"
                        }
                      },
                      {
                        "timeout": {
                          "default": 2000,
                          "type": "integer"
                        }
                      },
                      {
                        "username": {
                          "type": "string"
                        }
                      }
                    ],
                    "required": true,
                    "type": "record"
                  }
                },
                {
                  "strategy": {
                    "default": "off",
                    "one_of": [
                      "cluster",
                      "memory",
                      "off",
                      "redis"
                    ],
                    "required": true,
                    "type": "string"
                  }
                }
              ],
              "required": true,
              "type": "record"
            }
          },
          {
            "hide_credentials": {
              "default": true,
              "required": true,
              "type": "boolean"
            }
          },
          {
            "realm": {
              "default": "service",
              "required": true,
              "type": "string"
            }
          }
        ],
        "required": true,
        "type": "record"
      }
    }
  ]
}
