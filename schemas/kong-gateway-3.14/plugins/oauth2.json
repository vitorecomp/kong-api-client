{
  "fields": [
    {
      "consumer": {
        "eq": null,
        "reference": "consumers",
        "type": "foreign"
      }
    },
    {
      "protocols": {
        "default": [
          "grpc",
          "grpcs",
          "http",
          "https",
          "ws",
          "wss"
        ],
        "elements": {
          "one_of": [
            "grpc",
            "grpcs",
            "http",
            "https",
            "ws",
            "wss"
          ],
          "type": "string"
        },
        "required": true,
        "type": "set"
      }
    },
    {
      "consumer_group": {
        "eq": null,
        "reference": "consumer_groups",
        "type": "foreign"
      }
    },
    {
      "config": {
        "fields": [
          {
            "accept_http_if_already_terminated": {
              "default": false,
              "required": true,
              "type": "boolean"
            }
          },
          {
            "anonymous": {
              "type": "string"
            }
          },
          {
            "auth_header_name": {
              "default": "authorization",
              "type": "string"
            }
          },
          {
            "enable_authorization_code": {
              "default": false,
              "required": true,
              "type": "boolean"
            }
          },
          {
            "enable_client_credentials": {
              "default": false,
              "required": true,
              "type": "boolean"
            }
          },
          {
            "enable_implicit_grant": {
              "default": false,
              "required": true,
              "type": "boolean"
            }
          },
          {
            "enable_password_grant": {
              "default": false,
              "required": true,
              "type": "boolean"
            }
          },
          {
            "global_credentials": {
              "default": false,
              "required": true,
              "type": "boolean"
            }
          },
          {
            "hide_credentials": {
              "default": true,
              "required": true,
              "type": "boolean"
            }
          },
          {
            "mandatory_scope": {
              "default": false,
              "required": true,
              "type": "boolean"
            }
          },
          {
            "persistent_refresh_token": {
              "default": false,
              "required": true,
              "type": "boolean"
            }
          },
          {
            "pkce": {
              "default": "lax",
