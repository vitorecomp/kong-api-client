                "strict"
              ],
              "required": false,
              "type": "string"
            }
          },
          {
            "provision_key": {
              "auto": true,
              "required": true,
              "type": "string"
            }
          },
          {
            "realm": {
              "required": false,
              "type": "string"
            }
          },
          {
            "refresh_token_ttl": {
              "default": 1209600,
              "required": true,
              "type": "number"
            }
          },
          {
            "reuse_refresh_token": {
              "default": false,
              "required": true,
              "type": "boolean"
            }
          },
          {
            "scopes": {
              "elements": {
                "type": "string"
              },
              "type": "array"
            }
          },
          {
            "token_expiration": {
              "default": 7200,
              "required": true,
              "type": "number"
            }
