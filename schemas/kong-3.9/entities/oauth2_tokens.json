        "reference": "services",
        "type": "foreign"
      }
    },
    {
      "credential": {
        "on_delete": "cascade",
        "reference": "oauth2_credentials",
        "required": true,
        "type": "foreign"
      }
    },
    {
      "token_type": {
        "default": "bearer",
        "one_of": [
