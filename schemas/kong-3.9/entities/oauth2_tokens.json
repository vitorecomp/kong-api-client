        ],
        "required": true,
        "type": "string"
      }
    },
    {
      "expires_in": {
        "required": true,
        "type": "integer"
      }
    },
    {
      "access_token": {
        "auto": true,
        "required": false,
        "type": "string",
        "unique": true
      }
    },
    {
      "refresh_token": {
        "required": false,
        "type": "string",
        "unique": true
      }
    },
    {
      "authenticated_userid": {
        "required": false,
        "type": "string"
      }
