{
  "$comment": "Realistic plugin example configurations and update patches used by both the live fixture/round-trip suites and the generated plugin reference pages.",
  "plugins": {
    "acl": {
      "scope": "route",
      "config": {
        "allow": ["admin", "support"],
        "hide_groups_header": true
      },
      "update": {
        "patch": {
          "hide_groups_header": false
        },
        "field": "hide_groups_header",
        "value": false
      }
    },
    "acme": {
      "scope": "global",
      "config": {
        "account_email": "ops@example.com",
        "domains": ["api.example.com"],
        "storage": "shm",
        "tos_accepted": true
      },
      "update": {
        "patch": {
          "renew_threshold_days": 7
        },
        "field": "renew_threshold_days",
        "value": 7
      }
    },
    "ai-prompt-decorator": {
      "scope": "route",
      "config": {
        "prompts": {
          "prepend": [
            {
              "role": "system",
              "content": "Answer concisely and cite sources."
            }
          ]
        }
      },
      "update": {
        "patch": {
          "max_request_body_size": 16384
        },
        "field": "max_request_body_size",
        "value": 16384
      }
    },
    "ai-prompt-guard": {
      "scope": "route",
      "config": {
        "deny_patterns": ["ignore previous instructions"],
        "allow_all_conversation_history": false
      },
      "update": {
        "patch": {
          "max_request_body_size": 16384
        },
        "field": "max_request_body_size",
        "value": 16384
      }
    },
    "ai-prompt-template": {
      "scope": "route",
      "config": {
        "templates": [
          {
            "name": "summarize",
            "template": "{\"messages\":[{\"role\":\"user\",\"content\":\"Summarize: {{text}}\"}]}"
          }
        ],
        "allow_untemplated_requests": false
      },
      "update": {
        "patch": {
          "log_original_request": true
        },
        "field": "log_original_request",
        "value": true
      }
    },
    "ai-proxy": {
      "scope": "route",
      "config": {
        "route_type": "llm/v1/chat",
        "model": {
          "provider": "openai",
          "name": "gpt-4o-mini"
        },
        "auth": {
          "header_name": "Authorization",
          "header_value": "Bearer <your-api-key>"
        }
      },
      "update": {
        "patch": {
          "model_name_header": false
        },
        "field": "model_name_header",
        "value": false
      }
    },
    "ai-request-transformer": {
      "scope": "route",
      "config": {
        "prompt": "Rewrite the incoming JSON body to camelCase.",
        "llm": {
          "route_type": "llm/v1/chat",
          "model": {
            "provider": "openai",
            "name": "gpt-4o-mini"
          },
          "auth": {
            "header_name": "Authorization",
            "header_value": "Bearer <your-api-key>"
          }
        }
      },
      "update": {
        "patch": {
          "http_timeout": 30000
        },
        "field": "http_timeout",
        "value": 30000
      }
    },
    "ai-response-transformer": {
      "scope": "route",
      "config": {
        "prompt": "Summarize the upstream JSON response in one sentence.",
        "llm": {
          "route_type": "llm/v1/chat",
          "model": {
            "provider": "openai",
            "name": "gpt-4o-mini"
          },
          "auth": {
            "header_name": "Authorization",
            "header_value": "Bearer <your-api-key>"
          }
        }
      },
      "update": {
        "patch": {
          "http_timeout": 30000
        },
        "field": "http_timeout",
        "value": 30000
      }
    },
    "aws-lambda": {
      "scope": "route",
      "config": {
        "aws_region": "us-east-1",
        "function_name": "orders-handler",
        "invocation_type": "RequestResponse"
      },
      "update": {
        "patch": {
          "timeout": 30000
        },
        "field": "timeout",
        "value": 30000
      }
    },
    "azure-functions": {
      "scope": "route",
      "config": {
        "appname": "orders-func-app",
        "functionname": "process-order",
        "https": true
      },
      "update": {
        "patch": {
          "timeout": 30000
        },
        "field": "timeout",
        "value": 30000
      }
    },
    "basic-auth": {
      "scope": "route",
      "config": {
        "hide_credentials": true,
        "realm": "api"
      },
      "update": {
        "patch": {
          "realm": "admin"
        },
        "field": "realm",
        "value": "admin"
      }
    },
    "bot-detection": {
      "scope": "route",
      "config": {
        "deny": ["BadBot/1\\.0"],
        "allow": ["MonitoringBot/1\\.0"]
      },
      "update": {
        "patch": {
          "allow": ["HealthCheckBot/1\\.0"]
        },
        "field": "allow",
        "value": ["HealthCheckBot/1\\.0"]
      }
    },
    "correlation-id": {
      "scope": "route",
      "config": {
        "header_name": "X-Request-ID",
        "generator": "uuid#counter",
        "echo_downstream": true
      },
      "update": {
        "patch": {
          "echo_downstream": false
        },
        "field": "echo_downstream",
        "value": false
      }
    },
    "cors": {
      "scope": "route",
      "config": {
        "origins": ["https://app.example.com"],
        "methods": ["GET", "POST", "PUT", "DELETE"],
        "credentials": true,
        "max_age": 3600
      },
      "update": {
        "patch": {
          "max_age": 7200
        },
        "field": "max_age",
        "value": 7200
      }
    },
    "datadog": {
      "scope": "route",
      "config": {
        "host": "10.0.0.10",
        "port": 8125,
        "prefix": "kong"
      },
      "update": {
        "patch": {
          "prefix": "kong_prod"
        },
        "field": "prefix",
        "value": "kong_prod"
      }
    },
    "file-log": {
      "scope": "route",
      "config": {
        "path": "/tmp/kong-access.log",
        "reopen": true
      },
      "update": {
        "patch": {
          "reopen": false
        },
        "field": "reopen",
        "value": false
      }
    },
    "grpc-gateway": {
      "scope": "route",
      "config": {
        "proto": "/etc/kong/protos/service.proto"
      },
      "update": {
        "patch": {
          "proto": "/etc/kong/protos/service-v2.proto"
        },
        "field": "proto",
        "value": "/etc/kong/protos/service-v2.proto"
      }
    },
    "grpc-web": {
      "scope": "route",
      "config": {
        "allow_origin_header": "https://app.example.com"
      },
      "update": {
        "patch": {
          "pass_stripped_path": true
        },
        "field": "pass_stripped_path",
        "value": true
      }
    },
    "hmac-auth": {
      "scope": "route",
      "config": {
        "clock_skew": 300,
        "hide_credentials": true,
        "enforce_headers": ["date", "request-line"]
      },
      "update": {
        "patch": {
          "clock_skew": 600
        },
        "field": "clock_skew",
        "value": 600
      }
    },
    "http-log": {
      "scope": "route",
      "config": {
        "http_endpoint": "https://logs.example.com/ingest",
        "method": "POST",
        "timeout": 10000
      },
      "update": {
        "patch": {
          "timeout": 5000
        },
        "field": "timeout",
        "value": 5000
      }
    },
    "ip-restriction": {
      "scope": "route",
      "config": {
        "allow": ["192.0.2.0/24", "10.0.0.0/8"],
        "status": 403
      },
      "update": {
        "patch": {
          "message": "Access denied"
        },
        "field": "message",
        "value": "Access denied"
      }
    },
    "jwt": {
      "scope": "route",
      "config": {
        "claims_to_verify": ["exp"],
        "key_claim_name": "iss"
      },
      "update": {
        "patch": {
          "key_claim_name": "sub"
        },
        "field": "key_claim_name",
        "value": "sub"
      }
    },
    "key-auth": {
      "scope": "route",
      "config": {
        "key_names": ["X-API-Key"],
        "hide_credentials": true
      },
      "update": {
        "patch": {
          "key_in_body": true
        },
        "field": "key_in_body",
        "value": true
      }
    },
    "ldap-auth": {
      "scope": "route",
      "config": {
        "ldap_host": "ldap.example.com",
        "ldap_port": 389,
        "base_dn": "dc=example,dc=com",
        "attribute": "cn"
      },
      "update": {
        "patch": {
          "cache_ttl": 120
        },
        "field": "cache_ttl",
        "value": 120
      }
    },
    "loggly": {
      "scope": "route",
      "config": {
        "key": "<your-loggly-token>",
        "host": "logs-01.example.com",
        "log_level": "info"
      },
      "update": {
        "patch": {
          "port": 1514
        },
        "field": "port",
        "value": 1514
      }
    },
    "oauth2": {
      "scope": "route",
      "config": {
        "scopes": ["read", "write"],
        "mandatory_scope": true,
        "enable_client_credentials": true,
        "token_expiration": 7200
      },
      "update": {
        "patch": {
          "token_expiration": 3600
        },
        "field": "token_expiration",
        "value": 3600
      }
    },
    "opentelemetry": {
      "scope": "route",
      "config": {
        "traces_endpoint": "https://otel.example.com/v1/traces",
        "resource_attributes": {
          "service.name": "api-gateway"
        }
      },
      "update": {
        "patch": {
          "connect_timeout": 2000
        },
        "field": "connect_timeout",
        "value": 2000
      }
    },
    "post-function": {
      "scope": "route",
      "config": {
        "log": ["kong.log.info('request completed')"]
      },
      "update": {
        "patch": {
          "header_filter": ["kong.response.set_header('X-Processed-By', 'kong')"]
        },
        "field": "header_filter",
        "value": ["kong.response.set_header('X-Processed-By', 'kong')"]
      }
    },
    "pre-function": {
      "scope": "route",
      "config": {
        "access": ["kong.service.request.set_header('X-Gateway-Checked', 'true')"]
      },
      "update": {
        "patch": {
          "log": ["kong.log.debug('pre-function completed')"]
        },
        "field": "log",
        "value": ["kong.log.debug('pre-function completed')"]
      }
    },
    "prometheus": {
      "scope": "route",
      "config": {
        "latency_metrics": true,
        "status_code_metrics": true,
        "per_consumer": false
      },
      "update": {
        "patch": {
          "per_consumer": true
        },
        "field": "per_consumer",
        "value": true
      }
    },
    "proxy-cache": {
      "scope": "route",
      "config": {
        "strategy": "memory",
        "cache_ttl": 300,
        "content_type": ["application/json"]
      },
      "update": {
        "patch": {
          "cache_ttl": 60
        },
        "field": "cache_ttl",
        "value": 60
      }
    },
    "rate-limiting": {
      "scope": "route",
      "config": {
        "minute": 60,
        "policy": "local",
        "hide_client_headers": false
      },
      "update": {
        "patch": {
          "minute": 120
        },
        "field": "minute",
        "value": 120
      }
    },
    "redirect": {
      "scope": "route",
      "config": {
        "location": "https://api.example.com/v2",
        "status_code": 301,
        "keep_incoming_path": true
      },
      "update": {
        "patch": {
          "status_code": 302
        },
        "field": "status_code",
        "value": 302
      }
    },
    "request-size-limiting": {
      "scope": "route",
      "config": {
        "allowed_payload_size": 16,
        "size_unit": "megabytes",
        "require_content_length": true
      },
      "update": {
        "patch": {
          "allowed_payload_size": 32
        },
        "field": "allowed_payload_size",
        "value": 32
      }
    },
    "request-termination": {
      "scope": "route",
      "config": {
        "status_code": 503,
        "message": "Service temporarily unavailable"
      },
      "update": {
        "patch": {
          "message": "Scheduled maintenance"
        },
        "field": "message",
        "value": "Scheduled maintenance"
      }
    },
    "request-transformer": {
      "scope": "route",
      "config": {
        "add": {
          "headers": ["X-Gateway:kong"]
        },
        "remove": {
          "headers": ["X-Internal-Debug"]
        }
      },
      "update": {
        "patch": {
          "http_method": "POST"
        },
        "field": "http_method",
        "value": "POST"
      }
    },
    "response-ratelimiting": {
      "scope": "route",
      "config": {
        "limits": {
          "requests": {
            "minute": 100
          }
        },
        "header_name": "X-Kong-Limit",
        "policy": "local"
      },
      "update": {
        "patch": {
          "header_name": "X-Rate-Limit"
        },
        "field": "header_name",
        "value": "X-Rate-Limit"
      }
    },
    "response-transformer": {
      "scope": "route",
      "config": {
        "add": {
          "headers": ["X-Content-Type-Options:nosniff"]
        }
      },
      "update": {
        "patch": {
          "remove": {
            "headers": ["X-Powered-By"],
            "json": []
          }
        },
        "field": "remove",
        "value": {
          "headers": ["X-Powered-By"],
          "json": []
        }
      }
    },
    "session": {
      "scope": "route",
      "config": {
        "storage": "cookie",
        "cookie_name": "app_session",
        "cookie_same_site": "Lax",
        "idling_timeout": 900
      },
      "update": {
        "patch": {
          "idling_timeout": 1800
        },
        "field": "idling_timeout",
        "value": 1800
      }
    },
    "standard-webhooks": {
      "scope": "route",
      "config": {
        "secret_v1": "d2hzZWNfZXhhbXBsZV9zZWNyZXQ=",
        "tolerance_second": 300
      },
      "update": {
        "patch": {
          "tolerance_second": 600
        },
        "field": "tolerance_second",
        "value": 600
      }
    },
    "statsd": {
      "scope": "route",
      "config": {
        "host": "10.0.0.20",
        "port": 8125,
        "prefix": "kong"
      },
      "update": {
        "patch": {
          "prefix": "kong_prod"
        },
        "field": "prefix",
        "value": "kong_prod"
      }
    },
    "syslog": {
      "scope": "route",
      "config": {
        "log_level": "info",
        "facility": "user",
        "server_errors_severity": "err"
      },
      "update": {
        "patch": {
          "log_level": "notice"
        },
        "field": "log_level",
        "value": "notice"
      }
    },
    "tcp-log": {
      "scope": "route",
      "config": {
        "host": "192.0.2.10",
        "port": 5140,
        "tls": true
      },
      "update": {
        "patch": {
          "timeout": 5000
        },
        "field": "timeout",
        "value": 5000
      }
    },
    "udp-log": {
      "scope": "route",
      "config": {
        "host": "192.0.2.11",
        "port": 5140,
        "timeout": 10000
      },
      "update": {
        "patch": {
          "timeout": 5000
        },
        "field": "timeout",
        "value": 5000
      }
