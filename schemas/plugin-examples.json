{
  "$comment": "Minimal valid plugin configurations and update patches used by both the live fixture suite and the generated plugin reference pages.",
  "plugins": {
    "acl": {
      "scope": "route",
      "config": {
        "allow": ["admins"]
      },
      "update": {
        "patch": {
          "hide_groups_header": true
        },
        "field": "hide_groups_header",
        "value": true
      }
    },
    "acme": {
      "scope": "global",
      "config": {
        "account_email": "admin@example.com",
        "tos_accepted": true
      },
      "update": {
        "patch": {
          "renew_threshold_days": 7
        },
        "field": "renew_threshold_days",
        "value": 7
      }
    },
    "ai-prompt-decorator": {
      "scope": "route",
      "config": {
        "prompts": {
          "prepend": [
            {
              "role": "system",
              "content": "Answer concisely."
            }
          ]
        }
      },
      "update": {
        "patch": {
          "max_request_body_size": 16384
        },
        "field": "max_request_body_size",
        "value": 16384
      }
    },
    "ai-prompt-guard": {
      "scope": "route",
      "config": {
        "deny_patterns": ["ignore previous instructions"]
      },
      "update": {
        "patch": {
          "max_request_body_size": 16384
        },
        "field": "max_request_body_size",
        "value": 16384
      }
    },
    "ai-prompt-template": {
      "scope": "route",
      "config": {
        "templates": [
          {
            "name": "greet",
            "template": "{\"messages\":[{\"role\":\"user\",\"content\":\"Hello {{name}}\"}]}"
          }
        ]
      },
      "update": {
        "patch": {
          "log_original_request": true
        },
        "field": "log_original_request",
        "value": true
      }
    },
    "ai-proxy": {
      "scope": "route",
      "config": {
        "route_type": "llm/v1/chat",
        "model": {
          "provider": "openai",
          "name": "gpt-4o-mini"
        },
        "auth": {
          "header_name": "Authorization",
          "header_value": "Bearer test-key"
        }
      },
      "update": {
        "patch": {
          "model_name_header": false
        },
        "field": "model_name_header",
        "value": false
      }
    },
    "ai-request-transformer": {
      "scope": "route",
      "config": {
        "prompt": "Normalize the incoming request payload.",
        "llm": {
          "route_type": "llm/v1/chat",
          "model": {
            "provider": "openai",
            "name": "gpt-4o-mini"
          },
          "auth": {
            "header_name": "Authorization",
            "header_value": "Bearer test-key"
          }
        }
      },
      "update": {
        "patch": {
          "http_timeout": 30000
        },
        "field": "http_timeout",
        "value": 30000
      }
    },
    "ai-response-transformer": {
      "scope": "route",
      "config": {
        "prompt": "Summarize the upstream response.",
        "llm": {
          "route_type": "llm/v1/chat",
          "model": {
            "provider": "openai",
            "name": "gpt-4o-mini"
          },
          "auth": {
            "header_name": "Authorization",
            "header_value": "Bearer test-key"
          }
        }
      },
      "update": {
        "patch": {
          "http_timeout": 30000
        },
        "field": "http_timeout",
        "value": 30000
      }
    },
    "aws-lambda": {
      "scope": "route",
      "config": {
