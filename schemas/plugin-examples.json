    "zipkin": {
      "scope": "route",
      "config": {
        "http_endpoint": "https://zipkin.example.com/api/v2/spans",
        "sample_ratio": 0.1,
        "local_service_name": "api-gateway"
      },
      "update": {
        "patch": {
          "connect_timeout": 3000
        },
        "field": "connect_timeout",
        "value": 3000
      }
    }
  }
}
