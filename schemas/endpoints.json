{
  "$comment": "Hand-written endpoints (not CRUD-shaped) and the endpoints deliberately left out. Path parameters are written as {}. Every recorded endpoint must be accounted for by resources.json, by 'special', or by 'excluded'. For a special endpoint, 'methods' are the HTTP methods the library uses and 'call' is the library call that sends them, in the same order.",
  "special": {
    "/": {"methods": ["GET"], "call": "kong.node.info()"},
    "/status": {"methods": ["GET"], "call": "kong.node.status()"},
    "/status/dns": {"methods": ["GET"], "call": "kong.node.dnsStatus()"},
    "/endpoints": {"methods": ["GET"], "call": "kong.node.endpoints()"},
    "/timers": {"methods": ["GET"], "call": "kong.node.timers()"},
    "/metrics": {"methods": ["GET"], "call": "kong.node.metrics()"},
    "/tags": {"methods": ["GET"], "call": "kong.tags.list()"},
    "/tags/{}": {"methods": ["GET"], "call": "kong.tags.entities(tag)"},
    "/cache": {"methods": ["DELETE"], "call": "kong.cache.purge()"},
    "/cache/{}": {"methods": ["GET", "DELETE"], "call": "kong.cache.get(key), kong.cache.delete(key)"},
    "/config": {"methods": ["GET", "POST"], "call": "kong.config.get(), kong.config.load(config)"},
    "/clustering/data-planes": {"methods": ["GET"], "call": "kong.clustering.dataPlanes()"},
    "/clustering/status": {"methods": ["GET"], "call": "kong.clustering.status()"},
    "/debug/node/log-level": {"methods": ["GET"], "call": "kong.debug.getLogLevel()"},
    "/debug/node/log-level/{}": {"methods": ["PUT"], "call": "kong.debug.setLogLevel(level)"},
    "/debug/cluster/log-level/{}": {"methods": ["PUT"], "call": "kong.debug.setClusterLogLevel(level)"},
    "/schemas/{}": {"methods": ["GET"], "call": "kong.schemas.entity(name)"},
    "/schemas/{}/validate": {"methods": ["POST"], "call": "kong.schemas.validateEntity(name, body)"},
    "/schemas/plugins/{}": {"methods": ["GET"], "call": "kong.schemas.plugin(name)"},
    "/schemas/plugins/validate": {"methods": ["POST"], "call": "kong.schemas.validatePlugin(body)"},
    "/schemas/vaults/{}": {"methods": ["GET"], "call": "kong.schemas.vault(name)"},
    "/schemas/vaults/validate": {"methods": ["POST"], "call": "kong.schemas.validateVault(body)"},
    "/plugins/enabled": {"methods": ["GET"], "call": "kong.plugins.enabledNames()"},
    "/plugins/schema/{}": {"methods": ["GET"], "call": "kong.plugins.schema(name)"},
    "/upstreams/{}/health": {"methods": ["GET"], "call": "kong.upstreams.health(upstream)"},
    "/upstreams/{}/targets/all": {"methods": ["GET"], "call": "kong.upstreams.allTargets(upstream)"},
    "/upstreams/{}/targets/{}/healthy": {"methods": ["PUT"], "call": "kong.upstreams.setTargetHealth(upstream, target, 'healthy')"},
    "/upstreams/{}/targets/{}/unhealthy": {"methods": ["PUT"], "call": "kong.upstreams.setTargetHealth(upstream, target, 'unhealthy')"},
    "/upstreams/{}/targets/{}/{}/healthy": {"methods": ["PUT"], "call": "kong.upstreams.setTargetHealth(upstream, target, 'healthy', address)"},
    "/upstreams/{}/targets/{}/{}/unhealthy": {"methods": ["PUT"], "call": "kong.upstreams.setTargetHealth(upstream, target, 'unhealthy', address)"},
    "/acme": {"methods": ["POST", "PATCH"], "call": "kong.acme.createCertificate(host), kong.acme.renew()"},
    "/acme/certificates": {"methods": ["GET"], "call": "kong.acme.certificates()"},
    "/acme/certificates/{}": {"methods": ["GET"], "call": "kong.acme.certificate(host)"},
    "/proxy-cache": {"methods": ["DELETE"], "call": "kong.proxyCache.purge()"},
    "/proxy-cache/{}": {"methods": ["GET", "DELETE"], "call": "kong.proxyCache.get(cacheKey), kong.proxyCache.delete(cacheKey)"},
    "/proxy-cache/{}/caches/{}": {"methods": ["GET", "DELETE"], "call": "kong.proxyCache.get(cacheKey, pluginId), kong.proxyCache.delete(cacheKey, pluginId)"}
  },
  "excluded": {
    "/filter-chains": "WebAssembly filter chains need Wasm enabled and filters installed, and are absent from Kong Gateway 3.14",
    "/filter-chains/{}": "WebAssembly filter chains",
    "/filter-chains/{}/route": "WebAssembly filter chains",
    "/filter-chains/{}/service": "WebAssembly filter chains",
    "/routes/{}/filter-chains": "WebAssembly filter chains",
    "/routes/{}/filter-chains/{}": "WebAssembly filter chains",
    "/routes/{}/filters/all": "WebAssembly filter chains",
    "/routes/{}/filters/disabled": "WebAssembly filter chains",
    "/routes/{}/filters/enabled": "WebAssembly filter chains",
    "/services/{}/filter-chains": "WebAssembly filter chains",
    "/services/{}/filter-chains/{}": "WebAssembly filter chains",
    "/schemas/filters/{}": "WebAssembly filter chains",
    "/targets": "Kong lists this path but answers every request on it with 404; targets are served below an upstream",
    "/targets/{}": "Kong lists this path but answers every request on it with 404; targets are served below an upstream",
    "/targets/{}/upstream": "Kong lists this path but answers every request on it with 404; targets are served below an upstream",
    "/snis/{}/certificate": "Kong lists this path but answers every request on it with 404; the certificate of an SNI is read from the SNI itself or through /certificates/{sni name}"
  }
}
