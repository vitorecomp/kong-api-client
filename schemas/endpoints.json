{
  "$comment": "Hand-written endpoints (not CRUD-shaped) and the endpoints deliberately left out. Path parameters are written as {}. Every recorded endpoint must be accounted for by resources.json, by 'special', or by 'excluded'.",
  "special": {
    "/": "kong.node.info()",
    "/status": "kong.node.status()",
    "/status/dns": "kong.node.dnsStatus()",
    "/endpoints": "kong.node.endpoints()",
    "/timers": "kong.node.timers()",
    "/metrics": "kong.node.metrics()",
    "/tags": "kong.tags.list()",
    "/tags/{}": "kong.tags.entities(tag)",
    "/cache": "kong.cache.purge()",
    "/cache/{}": "kong.cache.get(key) / kong.cache.delete(key)",
    "/config": "kong.config.get() / kong.config.load(config)",
    "/clustering/data-planes": "kong.clustering.dataPlanes()",
    "/clustering/status": "kong.clustering.status()",
    "/debug/node/log-level": "kong.debug.getLogLevel()",
    "/debug/node/log-level/{}": "kong.debug.setLogLevel(level)",
    "/debug/cluster/log-level/{}": "kong.debug.setClusterLogLevel(level)",
    "/schemas/{}": "kong.schemas.entity(name)",
    "/schemas/{}/validate": "kong.schemas.validateEntity(name, body)",
    "/schemas/plugins/{}": "kong.schemas.plugin(name)",
    "/schemas/plugins/validate": "kong.schemas.validatePlugin(body)",
    "/schemas/vaults/{}": "kong.schemas.vault(name)",
    "/schemas/vaults/validate": "kong.schemas.validateVault(body)",
    "/plugins/enabled": "kong.plugins.enabledNames()",
    "/plugins/schema/{}": "kong.plugins.schema(name)",
    "/upstreams/{}/health": "kong.upstreams.health(upstream)",
    "/upstreams/{}/targets/all": "kong.upstreams.allTargets(upstream)",
    "/upstreams/{}/targets/{}/healthy": "kong.upstreams.setTargetHealth(upstream, target, 'healthy')",
    "/upstreams/{}/targets/{}/unhealthy": "kong.upstreams.setTargetHealth(upstream, target, 'unhealthy')",
    "/upstreams/{}/targets/{}/{}/healthy": "kong.upstreams.setTargetHealth(upstream, target, 'healthy', address)",
    "/upstreams/{}/targets/{}/{}/unhealthy": "kong.upstreams.setTargetHealth(upstream, target, 'unhealthy', address)",
    "/acme": "kong.acme.createCertificate(host) / kong.acme.renew()",
    "/acme/certificates": "kong.acme.certificates()",
    "/acme/certificates/{}": "kong.acme.certificate(host)",
    "/proxy-cache": "kong.proxyCache.purge()",
    "/proxy-cache/{}": "kong.proxyCache.get(cacheKey) / kong.proxyCache.delete(cacheKey)",
    "/proxy-cache/{}/caches/{}": "kong.proxyCache.get(cacheKey, pluginId) / kong.proxyCache.delete(cacheKey, pluginId)"
  },
  "excluded": {
    "/filter-chains": "WebAssembly filter chains need Wasm enabled and filters installed, and are absent from Kong Gateway 3.14",
    "/filter-chains/{}": "WebAssembly filter chains",
    "/filter-chains/{}/route": "WebAssembly filter chains",
    "/filter-chains/{}/service": "WebAssembly filter chains",
    "/routes/{}/filter-chains": "WebAssembly filter chains",
    "/routes/{}/filter-chains/{}": "WebAssembly filter chains",
    "/routes/{}/filters/all": "WebAssembly filter chains",
    "/routes/{}/filters/disabled": "WebAssembly filter chains",
    "/routes/{}/filters/enabled": "WebAssembly filter chains",
    "/services/{}/filter-chains": "WebAssembly filter chains",
    "/services/{}/filter-chains/{}": "WebAssembly filter chains",
    "/schemas/filters/{}": "WebAssembly filter chains"
  }
}
